# Server-only. Never expose this in client code or commit a real token.
REPLICATE_API_TOKEN=

# Community models need owner/name:version. Bare owner/name only works for official models.
REPLICATE_TRANSCRIPTION_MODEL=vaibhavs10/incredibly-fast-whisper:3ab86df6c8f54c11309d4d1f930ac292bad43ace52d10c80d87eb258b3c9f79c

# Upload and cost limits.
MAX_AUDIO_SIZE_MB=25
MAX_AUDIO_DURATION_SECONDS=600
DAILY_REQUEST_LIMIT=3
MAX_CONCURRENT_REQUESTS=1
REPLICATE_TIMEOUT_MS=120000

# Public site URL used for canonical links and the sitemap. No trailing slash.
SITE_URL=https://voztexto.org

# Reverse proxy header that YOUR proxy overwrites with the client address.
# Leave empty in local development. Production example: x-real-ip
# For x-forwarded-for, also set TRUSTED_PROXY_COUNT to the number of proxies you control.
TRUSTED_IP_HEADER=
TRUSTED_PROXY_COUNT=0

# Optional analytics and launch metadata.
GA_MEASUREMENT_ID=
GOOGLE_SITE_VERIFICATION=
CONTACT_EMAIL=hola@voztexto.org
